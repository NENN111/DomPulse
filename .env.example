DOMPULSE_DB=.local/dompulse.db
# Заполните все значения в локальном .env; не добавляйте реальные секреты в репозиторий.
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_API_BASE=https://platform-api2.max.ru
# Нужен только для API/webhook; для python -m app.polling можно оставить пустым.
MAX_WEBHOOK_SECRET=
# Необязательно: официальный ЕСИА/Госуслуги подключается через доверенный bridge.
# URL должен использовать HTTPS, секрет — не менее 32 символов.
GOSUSLUGI_BRIDGE_URL=
GOSUSLUGI_BRIDGE_SECRET=

# Бесплатный режим: ответы API не сохраняются, округ выбирает пользователь.
YANDEX_MAPS_API_KEY=
YANDEX_GEOCODER_URL=https://geocode-maps.yandex.ru/v1/
YANDEX_MAPS_ALLOW_STORAGE=false

# Публичный HTTPS-адрес /miniapp для кнопки-ссылки в боте (режим с одноразовым кодом).
MINIAPP_PUBLIC_URL=

# Только для Docker на VPS: публичный домен Mini App и почта для уведомлений ACME.
# Укажите имя без https://, например app.ваш-домен.ru. Символ _ в доменном имени недопустим.
CADDY_DOMAIN=
ACME_EMAIL=

# Для VPS с нестандартной цепочкой сертификатов MAX: PEM-файл в Docker-томе /data.
SSL_CERT_FILE=
SSL_CERT_DIR=
