DOMPULSE_DB=.local/dompulse.db
# Заполните все значения в локальном .env; не добавляйте реальные секреты в репозиторий.
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru
# Нужен только для API/webhook; для python -m app.polling можно оставить пустым.
MAX_WEBHOOK_SECRET=
# Необязательно: официальный ЕСИА/Госуслуги подключается через доверенный bridge.
# URL должен использовать HTTPS, секрет — не менее 32 символов.
GOSUSLUGI_BRIDGE_URL=
GOSUSLUGI_BRIDGE_SECRET=

# ?????????????: ?????? ???????? ?????? ?????? ????? ?????? ????????.
YANDEX_MAPS_API_KEY=
YANDEX_GEOCODER_URL=https://geocode-maps.yandex.ru/1.x/
YANDEX_MAPS_ALLOW_STORAGE=false
